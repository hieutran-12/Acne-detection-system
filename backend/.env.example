# Máy chủ
# Origin được gọi API, cách nhau bằng dấu phẩy. "*" là tất cả, chỉ nên dùng khi dev
CORS_ORIGINS=*

# Máy chủ model ở xa (Colab + ngrok), dùng khi deploy backend lên Render hoặc Vercel
# Để trống thì backend tự chạy model (máy có GPU), điền vào thì chỉ chuyển ảnh sang Colab
INFERENCE_URL=
# Khoá bí mật, phải trùng với INFER_API_KEY trong Colab Secrets
INFERENCE_API_KEY=
INFERENCE_TIMEOUT=60

# Model YOLO26m, ultralytics==8.4.192, chỉ dùng best.pt
# Đường dẫn tính từ thư mục backend/
MODEL_WEIGHTS=../model/y26m_1280/weights/best.pt
# Để trống thì tự chọn (có CUDA thì GPU 0, không thì CPU), hoặc đặt "cpu", "0"
MODEL_DEVICE=
MODEL_IMGSZ=1280
MODEL_IOU=0.7
MODEL_MAX_DET=500
# Dùng head NMS-free của YOLO26 (bản 8.4 truyền vào model là nms=False)
MODEL_END2END=true
# FP16, chỉ bật khi chạy CUDA (bản 8.4 truyền vào model là quantize=16)
MODEL_HALF=true

# Bỏ khung trùng vì head end2end hay sinh 2 khung lồng nhau trên 1 nốt: IoU >= DEDUP_IOU hoặc
# khung nhỏ nằm >= DEDUP_CONTAIN diện tích trong khung conf cao hơn. Đặt 0 để tắt điều kiện đó.
DEDUP_IOU=0.3
DEDUP_CONTAIN=0.7

# Ngưỡng conf để đếm mụn. 0.175 cho MAE thấp nhất trên cả val và test (eval_conf.py).
# Kéo thanh trượt trên web thì đếm lại ngay, không phải chạy lại model.
CONF_DEFAULT=0.175
# Model trả mọi khung có conf >= CONF_FLOOR, thanh trượt không kéo thấp hơn mức này
CONF_FLOOR=0.05
SHOW_CONF_SLIDER=true

# Trên Vercel đặt 4 vì Vercel chặn request trên 4,5 MB, FE sẽ tự nén ảnh lớn nhưng giữ độ phân giải
MAX_UPLOAD_MB=30
# Cạnh dài ảnh xem trước trả về FE, chỉ để hiển thị, model vẫn chạy trên ảnh gốc
PREVIEW_MAX=1600

# Thang Hayashi rút gọn, áp cho từng ảnh (khoảng nửa mặt)
# 0 là không phát hiện, 1-5 nhẹ, 6-20 trung bình, trên 20 nặng
SEV_MILD_MAX=5
SEV_MODERATE_MAX=20
# Gộp mức độ nhiều ảnh: max lấy mức cao nhất (mặc định), mean xếp theo số mụn trung bình mỗi ảnh
# Đừng áp ngưỡng lên tổng 3 ảnh.
SEV_AGGREGATE=max

# AI đưa lời khuyên
# gemini: Google Gemini (LLM_MODEL=gemini-2.5-flash, LLM_MAX_TOKENS=1500, không cần LLM_BASE_URL)
# openai: API nào tương thích OpenAI cũng được (OpenAI, OpenRouter, vLLM, Ollama...). Hoặc anthropic
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=700
LLM_TIMEOUT=30
