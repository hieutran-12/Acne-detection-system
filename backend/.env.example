# ===== Máy chủ =====
# Danh sách origin được phép gọi API, cách nhau bằng dấu phẩy ("*" = tất cả, chỉ nên dùng khi dev)
CORS_ORIGINS=*

# ===== Máy chủ model ở xa (Colab + ngrok) — dùng khi deploy backend lên Vercel =====
# Để TRỐNG = backend tự chạy model (máy có GPU). Có giá trị = chỉ chuyển ảnh sang Colab.
INFERENCE_URL=
# Khoá bí mật, phải TRÙNG với INFER_API_KEY trong Colab Secrets
INFERENCE_API_KEY=
INFERENCE_TIMEOUT=60

# ===== Model phát hiện mụn: YOLO26m, ultralytics==8.4.192 (chỉ dùng best.pt) =====
# Đường dẫn tính từ thư mục backend/
MODEL_WEIGHTS=../model/y26m_1280/weights/best.pt
# để trống = tự chọn (GPU 0 nếu torch có CUDA, không thì CPU); hoặc "cpu" / "0"
MODEL_DEVICE=
MODEL_IMGSZ=1280
MODEL_IOU=0.7
MODEL_MAX_DET=500
# end2end=True: head NMS-free của YOLO26 (ở 8.4 truyền vào model dưới tên nms=False)
MODEL_END2END=true
# half=True: FP16, chỉ bật khi chạy CUDA (ở 8.4 truyền dưới tên quantize=16)
MODEL_HALF=true

# Bỏ khung TRÙNG (head end2end hay sinh 2 khung lồng nhau trên 1 nốt): IoU >= DEDUP_IOU hoặc
# khung nhỏ nằm >= DEDUP_CONTAIN diện tích trong khung conf cao hơn. 0 = tắt điều kiện đó.
DEDUP_IOU=0.3
DEDUP_CONTAIN=0.7

# Ngưỡng conf mặc định để ĐẾM mụn. 0.175 = giữa vùng ổn định 0.15–0.20 (eval_conf.py trên 121 ảnh test).
# FE có thanh trượt lọc lại ngay không chạy lại model.
CONF_DEFAULT=0.175
# Model trả mọi khung có conf >= CONF_FLOOR; thanh trượt không kéo thấp hơn mức này
CONF_FLOOR=0.05
SHOW_CONF_SLIDER=true

# Trên Vercel đặt 4 (Vercel chặn request > 4,5 MB; FE tự nén lại ảnh lớn, giữ độ phân giải)
MAX_UPLOAD_MB=30
# Cạnh dài ảnh xem trước trả về FE (chỉ để hiển thị; model chạy trên ảnh gốc)
PREVIEW_MAX=1600

# ===== Mức độ theo thang Hayashi rút gọn, áp cho TỪNG ẢNH (nửa mặt) =====
# 0 = không phát hiện | 1..5 nhẹ | 6..20 trung bình | >20 nặng
SEV_MILD_MAX=5
SEV_MODERATE_MAX=20
# Gộp mức độ nhiều ảnh: max = mức cao nhất trong các ảnh (mặc định) | mean = xếp mức theo số mụn TB mỗi ảnh
# KHÔNG bao giờ áp ngưỡng lên tổng 3 ảnh.
SEV_AGGREGATE=max

# ===== AI đưa lời khuyên =====
# openai = mọi API tương thích OpenAI (OpenAI, Gemini-compat, OpenRouter, vLLM, Ollama...) | anthropic
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=700
LLM_TIMEOUT=30
