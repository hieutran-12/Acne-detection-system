# Backend mà Vite dev server proxy tới (/api)
VITE_BACKEND_URL=http://127.0.0.1:8000
# Chỉ đặt khi build production và API ở domain khác (ví dụ https://api.example.com), dev thì để trống
VITE_API_URL=
# Bật HTTPS khi dev, không có thì điện thoại không mở được camera qua địa chỉ LAN
VITE_HTTPS=true

# Thương hiệu và liên hệ hiện trên giao diện
VITE_BRAND_NAME=Ada Group
VITE_BRAND_TAGLINE=Làn da khỏe – Cuộc sống đẹp
# Link nút "Đặt lịch tư vấn" (Zalo, Facebook, form...). Để trống thì cuộn xuống phần liên hệ
VITE_BOOKING_URL=
VITE_HOTLINE=
VITE_CONTACT_EMAIL=
