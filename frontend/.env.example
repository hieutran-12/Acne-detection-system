# Backend FastAPI mà Vite dev-server sẽ proxy tới (/api)
VITE_BACKEND_URL=http://127.0.0.1:8000
# Chỉ đặt khi build production và API nằm ở domain khác (ví dụ https://api.example.com). Dev: để trống.
VITE_API_URL=
# Bật HTTPS khi dev (BẮT BUỘC để điện thoại mở được camera qua địa chỉ LAN)
VITE_HTTPS=true

# ===== Thương hiệu & liên hệ (hiển thị trên giao diện) =====
VITE_BRAND_NAME=Ada Group
VITE_BRAND_TAGLINE=Làn da khỏe – Cuộc sống đẹp
# Link nút "Đặt lịch tư vấn" (Zalo, Facebook, form đặt lịch... ). Để trống = cuộn xuống phần liên hệ
VITE_BOOKING_URL=
VITE_HOTLINE=
VITE_CONTACT_EMAIL=
